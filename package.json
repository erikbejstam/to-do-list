{
    "name": "todo-list",
    "version": "1.0.0",
    "private": true,
    "devDependencies": {
        "@types/express": "^5.0.2",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.1.2",
        "copyfiles": "^2.4.1",
        "prisma": "^6.8.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.8.3"
    },
    "scripts": {
        "build": "tsc && npm run copy",
        "copy": "copyfiles -u 1 'public/**/*' 'public/*' dist/",
        "watch-ts": "tsc --watch",
        "watch-static": "chokidar 'public/**/*' 'src/**/*' -c 'npm run copy'",
        "dev": "concurrently \"npm run watch-ts\" \"npm run watch-static\""
    },
    "dependencies": {
        "@prisma/client": "^6.8.2",
        "express": "^5.1.0"
    }
}
